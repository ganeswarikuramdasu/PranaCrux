# ======================================================
# PranaCrux - Environment Variables (.env.example)
# Copy this file to `.env` (repo root). The Spring Boot
# backend loads it automatically for local dev, but real
# environment variables / the Render dashboard always win.
#
# Deployment targets:
#   - Frontend ......... Vercel (vercel.json /api proxy -> Render)
#   - Backend .......... Render (Spring Boot web service)
#   - Database ......... Aiven MySQL (free)
# ======================================================

# --- MySQL Database (local dev defaults) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pranacrux
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password
# On Aiven set these instead:
# MYSQL_SSL_MODE=REQUIRED
# MYSQL_HOST=<aiven-host>.aivencloud.com
# MYSQL_PORT=<aiven-custom-port>
# MYSQL_USER=avnadmin

# --- Gemini AI API (used by AI features) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Backend public URL ---
# Local dev: http://localhost:8080
# Render:    https://<your-service>.onrender.com
APP_URL="http://localhost:8080"

# --- Email / OTP via Brevo (formerly Sendinblue) REST API ---
# Delivers OTP emails over plain HTTPS - no SMTP server or ports needed.
# Get a free key (300 emails/day): https://app.brevo.com/settings/keys/api
# If left empty, OTP emails are disabled and the code is auto-verified.
BREVO_API_KEY="your_brevo_api_key"
# Sender address - must be verified in your Brevo account.
EMAIL_FROM="PranaCrux Identity <noreply@example.com>"

# --- CORS allowed origins (comma separated) ---
# Local dev:  http://localhost:5173,http://localhost:3000
# Production: add your Vercel app URL, e.g. https://pranacrux-eight.vercel.app
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://pranacrux-eight.vercel.app"

# --- Local-only demo accounts ---
# Only enable for disposable local demo accounts. VITE_* values are visible to
# the browser during development; never configure them for a production build.
DEMO_SEED_ENABLED=false
DEMO_PATIENT_EMAIL=
DEMO_PATIENT_PASSWORD=
DEMO_DOCTOR_EMAIL=
DEMO_DOCTOR_PASSWORD=
DEMO_HOSPITAL_EMAIL=
DEMO_HOSPITAL_PASSWORD=
VITE_DEMO_PATIENT_EMAIL=
VITE_DEMO_PATIENT_PASSWORD=
VITE_DEMO_DOCTOR_EMAIL=
VITE_DEMO_DOCTOR_PASSWORD=
VITE_DEMO_HOSPITAL_EMAIL=
VITE_DEMO_HOSPITAL_PASSWORD=

# ======================================================
# DEPLOYMENT-ONLY (set these in Render's dashboard env vars)
# ======================================================
# SUPER_ADMIN_EMAIL=your-admin@example.com
# SUPER_ADMIN_PASSWORD=replace_with_a_strong_unique_password